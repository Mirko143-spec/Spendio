# Deploy image for the cluster: the site is built beforehand (Woodpecker's build-app step:
# `npm ci --omit=dev && npx vite build --outDir build`), so this only packages nginx and the
# finished files. Building Node inside kaniko ran out of memory on the cluster. Same nginx
# config and security headers as the main Dockerfile, which stays for local and GitHub builds.
FROM nginx:1.29-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY build /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
